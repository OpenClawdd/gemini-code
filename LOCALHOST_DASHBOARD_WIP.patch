+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import {
+  CommandKind,
+  type SlashCommand,
+  type SlashCommandActionReturn,
+} from './types.js';
+import {
+  startDashboardServer,
+  stopDashboardServer,
+  getDashboardStatus,
+} from '../local-dashboard/DashboardServer.js';
+
+export const localhostCommand: SlashCommand = {
+  name: 'localhost',
+  description: 'Manage the read-only localhost cockpit dashboard.',
+  kind: CommandKind.BUILT_IN,
+  isSafeConcurrent: true,
+  action: async (_context, args): Promise<SlashCommandActionReturn> => {
+    const subCommand = args.trim().toLowerCase();
+
+    if (subCommand === 'on') {
+      try {
+        const message = await startDashboardServer();
+        return {
+          type: 'message',
+          messageType: 'info',
+          content: message,
+        };
+      } catch (err: unknown) {
+        const message = err instanceof Error ? err.message : String(err);
+        return {
+          type: 'message',
+          messageType: 'error',
+          content: `Failed to start dashboard: ${message}`,
+        };
+      }
+    }
+
+    if (subCommand === 'off') {
+      stopDashboardServer();
+      return {
+        type: 'message',
+        messageType: 'info',
+        content: 'Dashboard stopped.',
+      };
+    }
+
+    if (subCommand === 'status' || !subCommand) {
+      return {
+        type: 'message',
+        messageType: 'info',
+        content: `Dashboard status: ${getDashboardStatus()}`,
+      };
+    }
+
+    return {
+      type: 'message',
+      messageType: 'error',
+      content: 'Usage: /localhost [on|off|status]',
+    };
+  },
+};
