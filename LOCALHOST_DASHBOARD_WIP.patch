+
+import http from 'node:http';
+import { getBuddyState } from '../companion/BuddyState.js';
+import { getCockpitState } from '../cockpit/CockpitState.js';
+import {
+  getAutopilotEvents,
+  getAutopilotMode,
+  setAutopilotMode,
+  updateDeferredStatus,
+} from '@google/gemini-cli-core';
+import { appEvents, AppEvent } from '../../utils/events.js';
+
+let server: http.Server | null = null;
+const PORT = 3000;
+const HOST = '127.0.0.1';
+
+export function startDashboardServer(): Promise<string> {
+  if (server) {
+    return Promise.resolve(
+      `Dashboard already running at http://${HOST}:${PORT}`,
+    );
+  }
+
+  server = http.createServer((req, res) => {
+    // 1. GET /api/state
+    if (req.url === '/api/state' && req.method === 'GET') {
+      const state = {
+        cockpit: getCockpitState(),
+        buddy: getBuddyState(),
+        events: getAutopilotEvents(),
+        autopilotMode: getAutopilotMode(),
+      };
+      res.writeHead(200, {
+        'Content-Type': 'application/json',
+        'Access-Control-Allow-Origin': '*',
+      });
+      res.end(JSON.stringify(state));
+      return;
+    }
+
+    // 2. POST /api/prompt
+    if (req.url === '/api/prompt' && req.method === 'POST') {
+      let body = '';
+      req.on('data', (chunk) => {
+        body += chunk.toString();
+      });
+      req.on('end', () => {
+        try {
+          const { text } = JSON.parse(body);
+          if (text) {
+            appEvents.emit(AppEvent.RemotePrompt, text);
+            res.writeHead(200, { 'Content-Type': 'application/json' });
+            res.end(JSON.stringify({ status: 'injected' }));
+          } else {
+            res.writeHead(400);
+            res.end('Missing text');
+          }
+        } catch (e) {
+          res.writeHead(400);
+          res.end('Invalid JSON');
+        }
+      });
+      return;
+    }
+
+    // 3. POST /api/deferred/:id/approve
+    const approveMatch = req.url?.match(/^\/api\/deferred\/(.+)\/approve$/);
+    if (approveMatch && req.method === 'POST') {
+      const id = approveMatch[1];
+      updateDeferredStatus(id, 'approved');
+      res.writeHead(200);
+      res.end(JSON.stringify({ status: 'approved' }));
+      return;
+    }
+
+    // 4. POST /api/deferred/:id/reject
+    const rejectMatch = req.url?.match(/^\/api\/deferred\/(.+)\/reject$/);
+    if (rejectMatch && req.method === 'POST') {
+      const id = rejectMatch[1];
+      updateDeferredStatus(id, 'rejected');
+      res.writeHead(200);
+      res.end(JSON.stringify({ status: 'rejected' }));
+      return;
+    }
+
+    // 5. POST /api/autopilot/mode
+    if (req.url === '/api/autopilot/mode' && req.method === 'POST') {
+      let body = '';
+      req.on('data', (chunk) => {
+        body += chunk.toString();
+      });
+      req.on('end', () => {
+        const { mode } = JSON.parse(body);
+        if (mode === 'normal' || mode === 'unattended') {
+          setAutopilotMode(mode);
+          res.writeHead(200);
+          res.end(JSON.stringify({ status: 'updated', mode }));
+        } else {
+          res.writeHead(400);
+          res.end('Invalid mode');
+        }
+      });
+      return;
+    }
+
+    // 6. Static HTML
+    if (req.url === '/' || req.url === '/index.html') {
+      res.writeHead(200, { 'Content-Type': 'text/html' });
+      res.end(renderDashboardHtml());
+      return;
+    }
+
+    // Handle CORS preflight
+    if (req.method === 'OPTIONS') {
+      res.writeHead(204, {
+        'Access-Control-Allow-Origin': '*',
+        'Access-Control-Allow-Methods': 'POST, GET, OPTIONS',
+        'Access-Control-Allow-Headers': 'Content-Type',
+      });
+      res.end();
+      return;
+    }
+
+    res.writeHead(404);
+    res.end();
+  });
+
+  return new Promise((resolve, reject) => {
+    server?.listen(PORT, HOST, () => {
+      resolve(`Dashboard started at http://${HOST}:${PORT}`);
+    });
+    server?.on('error', (err) => {
+      reject(err);
+    });
+  });
+}
+
+export function stopDashboardServer(): void {
+  if (server) {
+    server.close();
+    server = null;
+  }
+}
+
+export function getDashboardStatus(): string {
+  return server ? `Running at http://${HOST}:${PORT}` : 'Stopped';
+}
+
+function renderDashboardHtml(): string {
+  return `
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>gemini-code Flight Deck</title>
+    <style>
+        :root {
+            --bg: #0d1117;
+            --card-bg: rgba(22, 27, 34, 0.8);
+            --text: #c9d1d9;
+            --dim: #8b949e;
+            --cyan: #58a6ff;
+            --magenta: #bc8cff;
+            --green: #3fb950;
+            --yellow: #d29922;
+            --red: #f85149;
+            --border: rgba(255, 255, 255, 0.1);
+        }
+        body {
+            background-color: var(--bg);
+            color: var(--text);
+            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+            margin: 0;
+            padding: 16px;
+            display: flex;
+            flex-direction: column;
+            align-items: center;
+        }
+        .container {
+            width: 100%;
+            max-width: 600px;
+        }
+        .card {
+            background: var(--card-bg);
+            backdrop-filter: blur(12px);
+            -webkit-backdrop-filter: blur(12px);
+            border: 1px solid var(--border);
+            border-radius: 16px;
+            padding: 20px;
+            margin-bottom: 16px;
+            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
+        }
+        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
+        h1 { font-size: 1.2rem; color: var(--cyan); margin: 0; letter-spacing: 1px; }
+        .mode-badge { padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; background: rgba(88, 166, 255, 0.1); color: var(--cyan); border: 1px solid var(--cyan); }
+        .mode-unattended { background: rgba(188, 140, 255, 0.1); color: var(--magenta); border-color: var(--magenta); }
+        
+        .label { color: var(--dim); font-size: 0.75rem; text-transform: uppercase; margin-bottom: 6px; font-weight: 600; }
+        .value { font-size: 1.1rem; margin-bottom: 16px; }
+        .phase-badge { color: var(--green); border: 1px solid var(--green); padding: 2px 8px; border-radius: 4px; font-size: 0.9rem; }
+        
+        .buddy-box { border-left: 4px solid var(--magenta); padding-left: 12px; font-style: italic; color: var(--magenta); }
+
+        .deferred-item { border: 1px solid var(--yellow); border-radius: 8px; padding: 12px; margin-bottom: 12px; background: rgba(210, 153, 34, 0.05); }
+        .deferred-cmd { font-family: monospace; font-size: 0.9rem; margin-bottom: 8px; word-break: break-all; }
+        .actions { display: flex; gap: 12px; }
+        .btn { flex: 1; padding: 10px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; transition: opacity 0.2s; }
+        .btn:active { opacity: 0.7; }
+        .btn-approve { background: var(--green); color: white; }
+        .btn-reject { background: var(--red); color: white; }
+        
+        .timeline { margin-top: 20px; }
+        .event { display: flex; font-size: 0.85rem; margin-bottom: 10px; font-family: monospace; align-items: flex-start; }
+        .event-decision { width: 85px; font-weight: bold; flex-shrink: 0; }
+        .event-cmd { color: var(--dim); }
+        .allow { color: var(--green); }
+        .deny { color: var(--red); }
+        .ask { color: var(--yellow); }
+        .suppress { color: var(--dim); }
+
+        .composer { position: sticky; bottom: 16px; width: 100%; display: flex; gap: 8px; }
+        .composer input { flex: 1; background: #161b22; border: 1px solid var(--border); border-radius: 24px; padding: 12px 20px; color: white; outline: none; }
+        .composer button { background: var(--cyan); color: white; border: none; border-radius: 50%; width: 44px; height: 44px; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; cursor: pointer; }
+    </style>
+</head>
+<body>
+    <div class="container">
+        <div class="card">
+            <div class="header">
+                <h1>GC COCKPIT</h1>
+                <div id="mode-badge" class="mode-badge" onclick="toggleMode()">NORMAL</div>
+            </div>
+            <div class="label">Mission</div>
+            <div id="mission-goal" class="value">No active mission</div>
+            <div class="label">Status</div>
+            <div class="value"><span id="current-phase" class="phase-badge">INSPECT</span></div>
+        </div>
+
+        <div id="buddy-card" class="card">
+            <div class="label">Pollux (Buddy)</div>
+            <div id="buddy-message" class="buddy-box">Standing by.</div>
+        </div>
+
+        <div id="deferred-section" style="display: none;">
+            <div class="label">Deferred Queue</div>
+            <div id="deferred-list"></div>
+        </div>
+
+        <div class="card">
+            <div class="label">Activity Timeline</div>
+            <div id="events-list" class="timeline"></div>
+        </div>
+
+        <div class="composer">
+            <input type="text" id="prompt-input" placeholder="Steer the agent..." onkeypress="handleKey(event)">
+            <button onclick="sendPrompt()">→</button>
+        </div>
+    </div>
+
+    <script>
+        let currentMode = 'normal';
+
+        async function update() {
+            try {
+                const res = await fetch('/api/state');
+                const data = await res.json();
+                
+                document.getElementById('mission-goal').textContent = data.cockpit.missionBrief?.goal || 'No active mission';
+                document.getElementById('current-phase').textContent = data.cockpit.phase;
+                document.getElementById('buddy-message').textContent = data.buddy.message;
+                
+                currentMode = data.autopilotMode;
+                const badge = document.getElementById('mode-badge');
+                badge.textContent = currentMode.toUpperCase();
+                badge.className = 'mode-badge' + (currentMode === 'unattended' ? ' mode-unattended' : '');
+
+                const deferred = data.cockpit.recentDeferred || [];
+                const defSection = document.getElementById('deferred-section');
+                const defList = document.getElementById('deferred-list');
+                
+                if (deferred.length > 0) {
+                    defSection.style.display = 'block';
+                    defList.innerHTML = '';
+                    deferred.forEach(item => {
+                        const div = document.createElement('div');
+                        div.className = 'deferred-item';
+                        div.innerHTML = \`
+                            <div class="deferred-cmd">\${item.command}</div>
+                            <div class="label" style="font-size: 0.65rem">Reason: \${item.reason}</div>
+                            <div class="actions">
+                                <button class="btn btn-approve" onclick="approve('\${item.id}')">APPROVE</button>
+                                <button class="btn btn-reject" onclick="reject('\${item.id}')">REJECT</button>
+                            </div>
+                        \`;
+                        defList.appendChild(div);
+                    });
+                } else {
+                    defSection.style.display = 'none';
+                }
+
+                const events = data.events || [];
+                const list = document.getElementById('events-list');
+                list.innerHTML = '';
+                events.slice(0, 10).forEach(ev => {
+                    const div = document.createElement('div');
+                    div.className = 'event';
+                    div.innerHTML = \`<span class="event-decision \${ev.decision}">[\${ev.decision.toUpperCase()}]</span> <span class="event-cmd">\${ev.command}</span>\`;
+                    list.appendChild(div);
+                });
+            } catch (e) {
+                console.error('Update failed', e);
+            }
+        }
+
+        async function toggleMode() {
+            const nextMode = currentMode === 'normal' ? 'unattended' : 'normal';
+            await fetch('/api/autopilot/mode', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ mode: nextMode })
+            });
+            update();
+        }
+
+        async function approve(id) {
+            await fetch(\`/api/deferred/\${id}/approve\`, { method: 'POST' });
+            update();
+        }
+
+        async function reject(id) {
+            await fetch(\`/api/deferred/\${id}/reject\`, { method: 'POST' });
+            update();
+        }
+
+        async function sendPrompt() {
+            const input = document.getElementById('prompt-input');
+            const text = input.value.trim();
+            if (!text) return;
+            
+            input.value = '';
+            await fetch('/api/prompt', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ text })
+            });
+        }
+
+        function handleKey(e) { if (e.key === 'Enter') sendPrompt(); }
+
+        setInterval(update, 2000);
+        update();
+    </script>
+</body>
+</html>
+`;
+}
